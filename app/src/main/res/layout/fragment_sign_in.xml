<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="User"
            type="com.ex.pelicula.models.User" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/button4"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:background="@drawable/backgroundsigninup"
            android:text="Sıgn In"
            app:layout_constraintEnd_toEndOf="@+id/txt_in_password"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@id/txt_in_password"
            app:layout_constraintTop_toBottomOf="@id/txt_in_password"/>


        <EditText
            android:id="@id/txt_in_email"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginStart="64dp"
            android:layout_marginTop="250dp"
            android:background="@drawable/backgroundsigninup"
            android:hint="E-mail"
            android:text="@={User.email}"
            android:textAlignment="center"
            app:layout_constraintHorizontal_bias="0.611"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@id/txt_in_password"
            android:layout_width="280dp"
            android:layout_height="40dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/backgroundsigninup"
            android:hint="Password"
            android:text="@{User.password}"
            android:inputType="textPassword"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="@+id/txt_in_email"
            app:layout_constraintStart_toStartOf="@+id/txt_in_email"
            app:layout_constraintTop_toBottomOf="@+id/txt_in_email" />

        <TextView
            android:id="@+id/signUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="104dp"
            android:text="Sign Up"
            app:layout_constraintEnd_toEndOf="@+id/button4"
            app:layout_constraintHorizontal_bias="0.504"
            app:layout_constraintStart_toStartOf="@+id/button4"
            app:layout_constraintTop_toBottomOf="@+id/button4" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>