<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="user"
            type="com.ex.pelicula.viewModel.SignUpViewModel" />
    </data>

<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <!--     android:onClick="@{()->user.login()}"-->


    <Button
        android:id="@+id/button4"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:background="@drawable/backgroundsigninup"
        android:text="Sign Up"
        app:layout_constraintEnd_toEndOf="@+id/txt_lastName"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/txt_lastName"
        app:layout_constraintTop_toBottomOf="@+id/txt_lastName" />

    <EditText
        android:id="@+id/txt_email"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="264dp"
        android:background="@drawable/backgroundsigninup"
        android:gravity="center"
        android:hint="E-mail"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/txt_pass"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/backgroundsigninup"
        android:gravity="center"
        android:hint="Password"

        android:inputType="textPassword"
        app:layout_constraintEnd_toEndOf="@+id/txt_email"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/txt_email"
        app:layout_constraintTop_toBottomOf="@+id/txt_email" />


    <EditText
        android:id="@+id/txt_name"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/backgroundsigninup"
        android:gravity="center"
        android:hint="Name"

        app:layout_constraintEnd_toEndOf="@+id/txt_pass"
        app:layout_constraintStart_toStartOf="@+id/txt_pass"
        app:layout_constraintTop_toBottomOf="@+id/txt_pass" />

    <EditText
        android:id="@+id/txt_lastName"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/backgroundsigninup"
        android:gravity="center"
        android:hint="Last Name"

        app:layout_constraintEnd_toEndOf="@+id/txt_name"
        app:layout_constraintStart_toStartOf="@+id/txt_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_name" />


</androidx.constraintlayout.widget.ConstraintLayout>

    </layout>