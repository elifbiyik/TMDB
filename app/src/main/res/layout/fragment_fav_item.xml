<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="favMovie"
            type="com.ex.pelicula.models.FavoriteMovies" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_marginTop="45dp"
        android:elevation="10dp"
        android:orientation="vertical"
        app:cardCornerRadius="15dp">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="15dp">

            <include
                layout="@layout/fragment_fav"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />


            <TextView
                android:id="@+id/favName"
                android:layout_width="242dp"
                android:layout_height="96dp"
                android:layout_marginStart="20dp"
                android:gravity="center"
                android:padding="20dp"
                android:text="@{favMovie.original_title}"
                android:textColor="@color/purple"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@+id/favImage"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="MissingConstraints" />



<!--
            android:text="@{movie.original_title}"
-->


            <ImageView
                android:id="@+id/favImage"
                android:layout_width="99dp"
                android:layout_height="97dp"
                app:imageUrl="@{favMovie.poster_path}"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


<!--
            android:imageUrl="@{movie}"
-->

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>

