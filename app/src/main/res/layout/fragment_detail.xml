<?xml version="1.0" encoding="utf-8"?>


<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="movie"
            type="com.ex.pelicula.models.Movie" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.DetailFragment">


        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="393dp"
            android:layout_height="229dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="9dp"
            android:src="@drawable/ic_launcher_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <TextView
            android:id="@+id/movieName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="movieName"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@+id/imageView3"
            app:layout_constraintHorizontal_bias="0.498"
            app:layout_constraintStart_toStartOf="@+id/imageView3"
            app:layout_constraintTop_toBottomOf="@+id/imageView3" />

        <!--        android:text="@{movie.original_title}"-->


        <!--
        android:text="@{movie.vote_average}"
-->

        <!--
        android:text="@{movie.overview}"
-->


        <TextView
            android:id="@+id/movieAverage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="average"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="@+id/movieName"
            app:layout_constraintHorizontal_bias="0.508"
            app:layout_constraintStart_toStartOf="@+id/movieName"
            app:layout_constraintTop_toBottomOf="@+id/movieName" />

        <TextView
            android:id="@+id/movieOverview"
            android:layout_width="359dp"
            android:layout_height="217dp"
            android:layout_marginTop="36dp"
            android:text="overview"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/movieAverage"
            app:layout_constraintStart_toStartOf="@+id/movieAverage"
            app:layout_constraintTop_toBottomOf="@+id/movieAverage" />

        <ImageView
            android:id="@+id/detailfavorite"
            android:layout_width="50dp"
            android:layout_height="43dp"
            app:layout_constraintBottom_toBottomOf="@+id/imageView3"
            app:layout_constraintEnd_toEndOf="@+id/imageView3"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/imageView3"
            app:layout_constraintTop_toTopOf="@+id/imageView3"
            app:layout_constraintVertical_bias="0.0"
            app:srcCompat="@drawable/fav" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>